// --- Konstanta Waktu dan Sensor ---

#define SAMPLING_TIME_MS (100) // 100 ms
const uint16_t INA226_I2C_ADDRESS = 0x80;
const float INA226_BUS_VOLTAGE_LSB = 0.00125f;

//CAL = 0.00512 / (Current_LSB * R_SHUNT)
//Current_LSB harus dalam Ampere/bit: 0.5 mA/bit = 0.0005 A/bit
//R_SHUNT: 0.005 Ohm
//CAL = 0.00512 / (0.0005 * 0.005) = 0.00512 / 0.0000025 = 2048
#define INA226_CALIB_VAL_CUSTOM 2068
#define CURRENT_SENSOR_OFFSET 0.05

const float INA226_CURRENT_LSB_MA = 0.25f; // Diubah sesuai LSB (0.1mA / bit)

// --- Parameter Baterai (HANYA KAPASITAS YANG DIPERLUKAN UNTUK CC) ---
#define BATTERY_CAPACITY_AH (0.66f)

// --- Inisialisasi State Awal ---
#define INITIAL_SOC (1.0f)      // Mulai dari 100% (asumsi baterai penuh)

