/* USER CODE BEGIN 4 */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
  if (huart->Instance == USART1)
  {
    // Jika data yang diterima adalah 'c' atau 'C'
    if (uart_rx_buffer[0] == 'c' || uart_rx_buffer[0] == 'C') {
      system_state = STATE_CHARGING;
      char msg[] = "\r\nMode CHARGE diaktifkan.\r\n";
      HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
    }
    // Jika data yang diterima adalah 'd' atau 'D'
    else if (uart_rx_buffer[0] == 'd' || uart_rx_buffer[0] == 'D') {
      system_state = STATE_DISCHARGING;
      char msg[] = "\r\nMode DISCHARGE diaktifkan.\r\n";
      HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
    }
    else if (uart_rx_buffer[0] == 'i' || uart_rx_buffer[0] == 'I') {
          system_state = STATE_IDLE;
          char msg[] = "\r\nMode IDLE.\r\n";
          HAL_UART_Transmit(&huart1, (uint8_t*)msg, strlen(msg), HAL_MAX_DELAY);
    }

    // Aktifkan kembali interrupt untuk menerima karakter berikutnya
    HAL_UART_Receive_IT(&huart1, uart_rx_buffer, 1);
  }
}
