/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_USART1_UART_Init();
  MX_USB_DEVICE_Init();
  /* USER CODE BEGIN 2 */

  	INA226_setConfig(&hi2c1, INA226_I2C_ADDRESS, INA226_RESET_ACTIVE);
    HAL_Delay(5); // Beri jeda sangat singkat agar chip selesai reset

  	// Konfigurasi sensor INA226
    //uint16_t config = INA226_AVG_16 | INA226_VBUS_588uS | INA226_VSH_588uS | INA226_MODE_CONT_SHUNT_AND_BUS;
    uint16_t config = INA226_AVG_64 |           // Tingkatkan averaging menjadi 64 sampel
                        INA226_VBUS_1100uS |      // Perpanjang waktu konversi menjadi 1.1ms
                        INA226_VSH_1100uS |       // Perpanjang waktu konversi menjadi 1.1ms
                        INA226_MODE_CONT_SHUNT_AND_BUS; // Mode tetap continuous
    INA226_setConfig(&hi2c1, INA226_I2C_ADDRESS, config);
    INA226_setCalibrationReg(&hi2c1, INA226_I2C_ADDRESS, INA226_CALIB_VAL_CUSTOM);

    // Aktifkan interrupt UART untuk menerima 1 byte data
    HAL_UART_Receive_IT(&huart1, uart_rx_buffer, 1);

    // Kirim pesan prompt ke user melalui UART
    char prompt_msg[] = "\r\nMasukkan user input (c/d): ";
    HAL_UART_Transmit(&huart1, (uint8_t*)prompt_msg, strlen(prompt_msg), HAL_MAX_DELAY);

    // Kirim header untuk file CSV, agar mudah diimpor
    //char header[] = "Time(s),SOC(%),Voltage(V),Current(A)\r\n";
    //CDC_Transmit_FS((uint8_t*)header, strlen(header));

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  	  // Logika berdasarkan state saat ini
	      switch(system_state)
	      {
	        case STATE_IDLE:
	          // Matikan semua relay
	          HAL_GPIO_WritePin(CTRL_Charge_GPIO_Port, CTRL_Charge_Pin, GPIO_PIN_RESET);
	          HAL_GPIO_WritePin(CTRL_Load_GPIO_Port, CTRL_Load_Pin, GPIO_PIN_RESET);
	          // Kedipkan Indikator 1 sebagai penanda siap menerima input
	          HAL_GPIO_TogglePin(Indikator_1_GPIO_Port, Indikator_1_Pin);
	          HAL_GPIO_TogglePin(LED_Built_in_GPIO_Port, LED_Built_in_Pin);
	          // Matikan indikator lain
	          HAL_GPIO_WritePin(Indikator_2_GPIO_Port, Indikator_2_Pin, GPIO_PIN_RESET);
	          HAL_GPIO_WritePin(Indikator_3_GPIO_Port, Indikator_3_Pin, GPIO_PIN_RESET);
	          break;

	        case STATE_CHARGING:
	          // Nyalakan relay Charge, matikan relay Load
	          HAL_GPIO_WritePin(CTRL_Charge_GPIO_Port, CTRL_Charge_Pin, GPIO_PIN_SET);
	          HAL_GPIO_WritePin(CTRL_Load_GPIO_Port, CTRL_Load_Pin, GPIO_PIN_RESET);
	          break;

	        case STATE_DISCHARGING:
	          // Nyalakan relay Load, matikan relay Charge
	          HAL_GPIO_WritePin(CTRL_Load_GPIO_Port, CTRL_Load_Pin, GPIO_PIN_SET);
	          HAL_GPIO_WritePin(CTRL_Charge_GPIO_Port, CTRL_Charge_Pin, GPIO_PIN_RESET);
	          break;
	      }

	      // Proses logging hanya berjalan jika tidak dalam mode IDLE
	          if (system_state == STATE_CHARGING || system_state == STATE_DISCHARGING)
	          {
//	              // Baca Tegangan dan Arus
	              float measured_voltage = (float)INA226_getBusVReg(&hi2c1, INA226_I2C_ADDRESS) * INA226_BUS_VOLTAGE_LSB;
	              uint16_t current_raw = INA226_getCurrentReg(&hi2c1, INA226_I2C_ADDRESS);
//	              float32_t current_conversion = INA226_getCurrent(&hi2c1, INA226_I2C_ADDRESS);
	              float measured_current_mA = (float)((int16_t)current_raw) * INA226_CURRENT_LSB_MA;
	              float measured_current_A = (measured_current_mA / 1000.0f) + CURRENT_SENSOR_OFFSET;

//	        	  uint16_t voltage_raw = INA226_getBusVReg(&hi2c1, INA226_I2C_ADDRESS);
//	        	  uint16_t current_raw = INA226_getCurrentReg(&hi2c1, INA226_I2C_ADDRESS);
//	        	  uint16_t shunt_v_raw = INA226_getShuntV(&hi2c1, INA226_I2C_ADDRESS); // <-- BACA SHUNT VOLTAGE
//	        	  uint16_t calib_val   = INA226_getCalibrationReg(&hi2c1, INA226_I2C_ADDRESS); // <-- BACA NILAI KALIBRASI

	              // Hitung SoC CC
	              float sample_time_seconds = (float)SAMPLING_TIME_MS / 1000.0f;
	              float soc_delta = (measured_current_A * sample_time_seconds) / (BATTERY_CAPACITY_AH * 3600.0f);
	              soc_coulomb_counting -= soc_delta;
	              if (soc_coulomb_counting > 1.0f) soc_coulomb_counting = 1.0f;
	              if (soc_coulomb_counting < 0.0f) soc_coulomb_counting = 0.0f;

	              // Safety Cutoff
	              if (soc_coulomb_counting <= 0.0f) {
	                  HAL_GPIO_WritePin(CTRL_Load_GPIO_Port, CTRL_Load_Pin, GPIO_PIN_RESET);
	                  system_state = STATE_IDLE; // Kembali ke IDLE jika baterai habis
	              }

	              // Logika LED Indikator SOC
	              if (soc_coulomb_counting > 0.8f) {
	                  HAL_GPIO_WritePin(Indikator_1_GPIO_Port, Indikator_1_Pin, GPIO_PIN_SET);
	                  HAL_GPIO_WritePin(Indikator_2_GPIO_Port, Indikator_2_Pin, GPIO_PIN_RESET);
	                  HAL_GPIO_WritePin(Indikator_3_GPIO_Port, Indikator_3_Pin, GPIO_PIN_RESET);
	              } else if (soc_coulomb_counting >= 0.2f) {
	                  HAL_GPIO_WritePin(Indikator_1_GPIO_Port, Indikator_1_Pin, GPIO_PIN_RESET);
	                  HAL_GPIO_WritePin(Indikator_2_GPIO_Port, Indikator_2_Pin, GPIO_PIN_SET);
	                  HAL_GPIO_WritePin(Indikator_3_GPIO_Port, Indikator_3_Pin, GPIO_PIN_RESET);
	              } else {
	                  HAL_GPIO_WritePin(Indikator_1_GPIO_Port, Indikator_1_Pin, GPIO_PIN_RESET);
	                  HAL_GPIO_WritePin(Indikator_2_GPIO_Port, Indikator_2_Pin, GPIO_PIN_RESET);
	                  HAL_GPIO_WritePin(Indikator_3_GPIO_Port, Indikator_3_Pin, GPIO_PIN_SET);
	              }

	              // Tampilkan data ke UART
	              char tx_buffer[128];
//	              sprintf(tx_buffer, "SOC:%.2f, V:%.3f, I:%.3f, I_raw:%d\r\n",
//	                          soc_coulomb_counting * 100.0f,
//	                          measured_voltage,
//							  measured_current_A,
//	                          (int16_t)current_raw); // Tampilkan nilai raw sebagai signed integer
	              //bentuk CSV
	              sprintf(tx_buffer, "%lu,%.4f,%.4f,%.4f,%.4d\r\n",
	                      time_ms / 1000,
	                      soc_coulomb_counting * 100.0f,
	                      measured_voltage,
	                      measured_current_A,
						  current_raw);

//	              sprintf(tx_buffer, "V_bus:%.3fV, V_raw:%d, I_raw:%d, Shunt_raw:%d, Calib:%d\r\n",
//	                          measured_voltage,
//	                          voltage_raw,
//	                          (int16_t)current_raw,   // Tampilkan sebagai signed int
//	                          (int16_t)shunt_v_raw,   // Tampilkan sebagai signed int
//	                          calib_val);

	              HAL_UART_Transmit(&huart1, (uint8_t*)tx_buffer, strlen(tx_buffer), 10);
	              }

	          // Update timestamp
	          time_ms += SAMPLING_TIME_MS;

	          // Tunggu sesuai waktu sampling
	          HAL_Delay(SAMPLING_TIME_MS);

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

