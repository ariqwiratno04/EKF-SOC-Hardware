// Variabel untuk state machine
static volatile SystemState_t system_state = STATE_IDLE;

// Variabel untuk menyimpan state SoC dari Coulomb Counting
static float soc_coulomb_counting = INITIAL_SOC;
// Variabel untuk timestamp data logging
static uint32_t time_ms = 0;

uint8_t uart_rx_buffer[1];
// --- Flag untuk Kontrol dari User ---
volatile uint8_t start_charge_flag = 0;
volatile uint8_t start_discharge_flag = 0;

//EepromData_t eeprom_data;
