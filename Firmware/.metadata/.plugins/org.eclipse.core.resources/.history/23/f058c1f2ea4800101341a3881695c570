// Alamat I2C INA226. Umumnya 0x40 jika A0 & A1 ke Ground.
// Library ini menggunakan alamat 8-bit (digeser ke kiri 1 bit)
const uint16_t INA226_I2C_ADDRESS = 0x80;

// Nilai konversi untuk tegangan bus (1.25mV per bit)
const float INA226_BUS_VOLTAGE_LSB = 0.00125f;

