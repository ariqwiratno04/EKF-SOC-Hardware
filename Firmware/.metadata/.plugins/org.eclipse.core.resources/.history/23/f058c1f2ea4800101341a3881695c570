/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_USART1_UART_Init();
  MX_USB_DEVICE_Init();
  /* USER CODE BEGIN 2 */
  uint16_t config = INA226_AVG_16 |           // 16x averaging
                      INA226_VBUS_588uS |         // 588us bus voltage conversion time
                      INA226_VSH_588uS |          // 588us shunt voltage conversion time
                      INA226_MODE_CONT_SHUNT_AND_BUS; // Mode kontinu

    // Kirim konfigurasi ke sensor menggunakan handle i2c 'hi2c1' dari CubeMX
    INA226_setConfig(&hi2c1, INA226_I2C_ADDRESS, config);

    // Beri jeda singkat untuk memastikan sensor siap
    HAL_Delay(100);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  uint16_t bus_voltage_raw;
	  float bus_voltage_volt;
	  char tx_buffer[64];

	      // 1. Baca nilai MENTAH dari register. Kita gunakan ...Reg() karena lebih andal
	      bus_voltage_raw = INA226_getBusVReg(&hi2c1, INA226_I2C_ADDRESS);

	      // 2. Lakukan konversi manual ke Volt
	      bus_voltage_volt = (float)bus_voltage_raw * INA226_BUS_VOLTAGE_LSB;

	      // 3. Format data menjadi string
	      sprintf(tx_buffer, "Bus Voltage: %.3f V\r\n", bus_voltage_volt);

	      // 4. Kirim string melalui USB Virtual COM Port
	      CDC_Transmit_FS((uint8_t*)tx_buffer, strlen(tx_buffer));

	      HAL_GPIO_TogglePin(LED_Built_in_GPIO_Port, LED_Built_in_Pin);

	      // 5. Beri jeda 1 detik sebelum pembacaan berikutnya
	      HAL_Delay(1000);
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */


  }
  /* USER CODE END 3 */
}

